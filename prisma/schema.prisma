generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SELLER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum MessageDirection {
  IN
  OUT
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum DocumentKind {
  PROPOSAL
  CONTRACT
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Company {
  id            String             @id @default(cuid())
  name          String
  // Minutes a seller has to accept a lead before it moves on. 0 = assigned without acceptance.
  acceptMinutes Int                @default(0)
  createdAt     DateTime           @default(now())
  memberships   Membership[]
  teams         Team[]
  contacts      Contact[]
  pipelines     Pipeline[]
  deals         Deal[]
  products      Product[]
  tasks         Task[]
  channels      Channel[]
  conversations Conversation[]
  activities    Activity[]
  leadSources   LeadSource[]
  queueMembers  QueueMember[]
  assignments   LeadAssignment[]
  templates     DocumentTemplate[]
  proposals     Proposal[]
  visits        Visit[]
}

model User {
  id            String           @id @default(cuid())
  name          String
  email         String           @unique
  // WhatsApp number that receives new-lead alerts.
  phone         String?
  passwordHash  String
  createdAt     DateTime         @default(now())
  memberships   Membership[]
  ownedContacts Contact[]
  ownedDeals    Deal[]
  tasks         Task[]
  conversations Conversation[]
  activities    Activity[]
  queueMembers  QueueMember[]
  assignments   LeadAssignment[]
  proposals     Proposal[]
  visits        Visit[]
}

model Membership {
  id        String  @id @default(cuid())
  role      Role    @default(SELLER)
  userId    String
  companyId String
  teamId    String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team      Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
}

model Team {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  createdAt   DateTime     @default(now())
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]
}

model Contact {
  id            String         @id @default(cuid())
  companyId     String
  name          String
  phone         String?
  email         String?
  source        String?
  tags          String[]
  ownerId       String?
  createdAt     DateTime       @default(now())
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  deals         Deal[]
  tasks         Task[]
  conversations Conversation[]
  activities    Activity[]
  visits        Visit[]

  @@unique([companyId, phone])
  @@index([companyId, createdAt])
}

model Pipeline {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  createdAt   DateTime     @default(now())
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages      Stage[]
  deals       Deal[]
  leadSources LeadSource[]
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  position   Int
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@index([pipelineId, position])
}

model Deal {
  id             String           @id @default(cuid())
  companyId      String
  pipelineId     String
  stageId        String
  contactId      String
  ownerId        String?
  leadSourceId   String?
  campaign       String?
  title          String
  value          Decimal          @default(0) @db.Decimal(12, 2)
  status         DealStatus       @default(OPEN)
  lostReason     String?
  stageEnteredAt DateTime         @default(now())
  // First time the seller acted on the deal (message, note, stage move, visit, proposal).
  firstContactAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline       Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage          Stage            @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner          User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leadSource     LeadSource?      @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  products       DealProduct[]
  tasks          Task[]
  activities     Activity[]
  assignments    LeadAssignment[]
  proposals      Proposal[]
  visits         Visit[]

  @@index([companyId, pipelineId, status])
  @@index([companyId, createdAt])
}

model Product {
  id        String        @id @default(cuid())
  companyId String
  name      String
  price     Decimal       @default(0) @db.Decimal(12, 2)
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals     DealProduct[]
}

model DealProduct {
  id        String  @id @default(cuid())
  dealId    String
  productId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  dueAt       DateTime?
  doneAt      DateTime?
  assigneeId  String?
  contactId   String?
  dealId      String?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([companyId, doneAt, dueAt])
}

// A messaging connection. Only WhatsApp Cloud API for now.
model Channel {
  id            String         @id @default(cuid())
  companyId     String
  kind          String         @default("whatsapp")
  name          String
  phoneNumberId String         @unique
  accessToken   String
  verifyToken   String
  createdAt     DateTime       @default(now())
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
}

model Conversation {
  id            String             @id @default(cuid())
  companyId     String
  channelId     String
  contactId     String
  assigneeId    String?
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel       Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee      User?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([channelId, contactId])
  @@index([companyId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  body           String
  externalId     String?          @unique
  error          String?
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Timeline entry shown on contact and deal pages.
model Activity {
  id        String   @id @default(cuid())
  companyId String
  kind      String
  text      String
  userId    String?
  contactId String?
  dealId    String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
}

// Where leads come from (a Facebook form via Zapier/Make, a listing portal, the website).
// Each source has a secret URL that receives leads.
model LeadSource {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  token      String   @unique
  pipelineId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]
}

// A seller taking part in the lead rotation.
model QueueMember {
  id           String    @id @default(cuid())
  companyId    String
  userId       String
  weight       Int       @default(1)
  active       Boolean   @default(true)
  // Lead sources this seller serves. Empty = all sources.
  sourceIds    String[]
  served       Int       @default(0)
  lastServedAt DateTime?
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

// One offer of a lead to a seller.
model LeadAssignment {
  id          String           @id @default(cuid())
  companyId   String
  dealId      String
  userId      String
  status      AssignmentStatus @default(PENDING)
  expiresAt   DateTime?
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal        Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status, expiresAt])
  @@index([dealId])
}

model DocumentTemplate {
  id        String       @id @default(cuid())
  companyId String
  kind      DocumentKind
  name      String
  body      String
  createdAt DateTime     @default(now())
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// A proposal or contract generated for a deal. The body is a snapshot, editable until sent.
model Proposal {
  id          String         @id @default(cuid())
  companyId   String
  dealId      String
  kind        DocumentKind
  number      Int
  title       String
  body        String
  total       Decimal        @default(0) @db.Decimal(12, 2)
  status      ProposalStatus @default(DRAFT)
  // Secret for the public link the client opens.
  token       String         @unique
  signerName  String?
  createdById String?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal        Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, kind, number])
}

model Visit {
  id          String    @id @default(cuid())
  companyId   String
  contactId   String
  dealId      String?
  userId      String?
  startsAt    DateTime
  durationMin Int       @default(60)
  place       String?
  notes       String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, startsAt])
}
